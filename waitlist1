<script>
// ── CONFIG ────────────────────────────────────────────────
// Paste your deployed Apps Script Web App URL here:
var SCRIPT_URL = "https://script.google.com/macros/s/AKfycbx0h36ao2g8HTYeWX5pKlND32CvQtXxXqews_haDJ13qS9kDJumA1b1IfsS64BHzPYQ/exec";
// ─────────────────────────────────────────────────────────

// ── Progress tracking ─────────────────────────────────────
var requiredFields = [
  'full_name','email','whatsapp','country',
  'track','heard','device_access','age_18_plus','funding'
];

function updateProgress() {
  var filled = 0;
  requiredFields.forEach(function(fname) {
    var el = document.getElementById(fname);
    if (el) {
      if (el.value && el.value.trim()) filled++;
    } else {
      var radios = document.querySelectorAll('input[name="' + fname + '"]:checked');
      if (radios.length) filled++;
    }
  });
  var pct = Math.round((filled / requiredFields.length) * 100);
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressPct').textContent = pct + '%';
}

// Track selects too (country dropdown)
document.querySelectorAll('input, textarea, select').forEach(function(el) {
  el.addEventListener('input', updateProgress);
  el.addEventListener('change', updateProgress);
});

// ── Validation ────────────────────────────────────────────
function validateEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }

function showErr(id, doShow) {
  var el = document.getElementById('err-' + id);
  if (el) el.classList[doShow ? 'add' : 'remove']('show');
}

function setInvalid(id, invalid) {
  var el = document.getElementById(id);
  if (!el) return;
  el.classList[invalid ? 'add' : 'remove']('invalid');
}

function validateForm() {
  var ok = true;

  var nameVal    = document.getElementById('full_name').value.trim();
  var emailVal   = document.getElementById('email').value.trim();
  var waVal      = document.getElementById('whatsapp').value.trim();
  var countryVal = document.getElementById('country').value;

  showErr('full_name', !nameVal);              setInvalid('full_name', !nameVal);              if (!nameVal) ok = false;
  showErr('email', !validateEmail(emailVal));  setInvalid('email', !validateEmail(emailVal));  if (!validateEmail(emailVal)) ok = false;
  showErr('whatsapp', !waVal);                 setInvalid('whatsapp', !waVal);                 if (!waVal) ok = false;

  var countryEl  = document.getElementById('country');
  var noCountry  = !countryVal;
  showErr('country', noCountry);
  countryEl.style.borderColor = noCountry ? 'var(--error)' : '';
  if (noCountry) ok = false;

  var radioGroups = ['track','heard','device_access','age_18_plus','funding'];
  radioGroups.forEach(function(n) {
    var checked = document.querySelector('input[name="' + n + '"]:checked');
    showErr(n, !checked);
    if (!checked) ok = false;
  });

  return ok;
}

// ── Form submission ───────────────────────────────────────
document.getElementById('cohortForm').addEventListener('submit', function(e) {
  e.preventDefault();

  if (!validateForm()) {
    var firstErr = document.querySelector('.field-error.show');
    if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }

  // Lock the button immediately
  var btn = document.getElementById('btnSubmit');
  btn.disabled = true;
  document.getElementById('btnText').textContent = 'Submitting...';
  document.getElementById('btnSpinner').style.display = 'inline-block';
  document.getElementById('btnArrow').style.display = 'none';

  // Collect all field values
  function val(id) { var el = document.getElementById(id); return el ? el.value : ''; }
  function radio(n) { var el = document.querySelector('input[name="' + n + '"]:checked'); return el ? el.value : ''; }

  var payload = {
    timestamp:     new Date().toLocaleString('en-GB'),
    full_name:     val('full_name'),
    email:         val('email'),
    whatsapp:      val('whatsapp'),
    track:         radio('track'),
    country:       val('country'),
    heard:         radio('heard'),
    device_access: radio('device_access'),
    age_18_plus:   radio('age_18_plus'),
    funding:       radio('funding'),
    open_text:     val('open_text')
  };

  // ── KEY FIX 1: Check the URL is real before trying to fetch ──
  if (!SCRIPT_URL || SCRIPT_URL.indexOf('YOUR_APPS_SCRIPT') !== -1) {
    console.error('SCRIPT_URL has not been set. Paste your Web App URL into the SCRIPT_URL variable.');
    showSuccess(); // still show success so the UI doesn't hang
    return;
  }

  // ── KEY FIX 2: Send as text/plain — required for no-cors mode ──
  // Apps Script receives this and JSON.parse() still works on the server side.
  // Sending Content-Type: application/json with no-cors triggers a CORS
  // preflight that Apps Script doesn't respond to, killing the request silently.
  fetch(SCRIPT_URL, {
    method:  'POST',
    headers: { 'Content-Type': 'text/plain' }, // must be text/plain with no-cors
    body:    JSON.stringify(payload),
    mode:    'no-cors' // required for Apps Script Web Apps
  })
  .then(function() {
    // no-cors means we can't read the response body, but the request was sent.
    // Apps Script receives it and writes to the sheet regardless.
    showSuccess();
  })
  .catch(function(err) {
    // Network failure (no internet, wrong URL, etc.)
    console.error('Fetch error:', err);
    // Re-enable button so user can try again
    btn.disabled = false;
    document.getElementById('btnText').textContent = 'Register My Interest';
    document.getElementById('btnSpinner').style.display = 'none';
    document.getElementById('btnArrow').style.display = 'inline';
    alert('There was a network error. Please check your connection and try again.');
  });
});

function showSuccess() {
  document.getElementById('cohortForm').style.display = 'none';
  document.getElementById('progressWrap').style.display = 'none';
  var ss = document.getElementById('successScreen');
  ss.style.display = 'block';
  document.getElementById('formSection').style.background = '#1C2333';
  document.getElementById('formSection').style.position = 'relative';
  document.querySelector('.page-hero').style.paddingBottom = '60px';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ── Scroll-based progress bar fade ───────────────────────
var formTop = document.getElementById('formSection').offsetTop;
window.addEventListener('scroll', function() {
  var pw = document.getElementById('progressWrap');
  pw.style.opacity = window.scrollY > formTop - 80 ? '1' : '0.4';
}, { passive: true });
</script>

