<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Preneurdemy — Cohort 1 Interest Registration</title>
<meta name="description" content="Register your interest in Preneurdemy Cohort 1 — AI Digital Marketing, AI Data Analytics, and AI & Automation.">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,700;1,9..144,400;1,9..144,700&display=swap" rel="stylesheet">
<style>
/* ── Reset & tokens ─────────────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
:root{
  --navy:       #1C2333;
  --navy-mid:   #2A3550;
  --navy-light: #3A4A6A;
  --teal:       #4DD9C0;
  --teal-deep:  #0E6D5E;
  --teal-glow:  rgba(77,217,192,0.18);
  --teal-pale:  rgba(77,217,192,0.08);
  --amber:      #F5A623;
  --amber-pale: rgba(245,166,35,0.12);
  --white:      #FFFFFF;
  --off-white:  #F7F9FC;
  --grey-light: #EEF1F6;
  --grey:       #8A96A8;
  --ink:        #1C2333;
  --ink-soft:   #4A5568;
  --border:     rgba(77,217,192,0.2);
  --border-grey:#DDE3EE;
  --error:      #E53E3E;
  --success:    #38A169;
}
body{
  font-family:'DM Sans',system-ui,sans-serif;
  background:var(--navy);
  color:var(--ink);
  min-height:100vh;
  overflow-x:hidden;
}
@media(prefers-reduced-motion:reduce){
  *{animation-duration:.01ms!important;transition-duration:.01ms!important}
}

/* ── Hero / header ──────────────────────────────────────── */
.page-hero{
  position:relative;
  background:var(--navy);
  padding:60px 24px 120px;
  text-align:center;
  overflow:hidden;
}

/* Flame glow — the signature element */
.flame-glow{
  position:absolute;
  top:-80px; left:50%; transform:translateX(-50%);
  width:500px; height:500px;
  border-radius:50%;
  background:radial-gradient(ellipse 60% 70% at 50% 40%,
    rgba(77,217,192,0.22) 0%,
    rgba(77,217,192,0.08) 40%,
    transparent 70%);
  pointer-events:none;
  animation:breathe 6s ease-in-out infinite;
}
@keyframes breathe{
  0%,100%{transform:translateX(-50%) scale(1);opacity:1}
  50%{transform:translateX(-50%) scale(1.08);opacity:0.85}
}

/* Ambient dots */
.hero-grain{
  position:absolute;inset:0;pointer-events:none;opacity:0.35;
  background-image:radial-gradient(circle,rgba(77,217,192,0.06) 1px,transparent 1px);
  background-size:28px 28px;
}

.hero-inner{position:relative;z-index:2;max-width:640px;margin:0 auto}

/* Logo mark */
.logo-wrap{
  display:inline-flex;align-items:center;gap:12px;
  margin-bottom:32px;
}
.logo-img{
  width:44px;height:44px;border-radius:50%;
  box-shadow:0 0 0 2px rgba(77,217,192,0.3), 0 0 24px rgba(77,217,192,0.2);
}
.logo-name{
  font-family:'DM Sans',sans-serif;font-weight:700;font-size:18px;
  color:var(--white);letter-spacing:-0.3px;
}
.logo-name span{color:var(--teal)}

.hero-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(77,217,192,0.1);
  border:1px solid rgba(77,217,192,0.25);
  border-radius:30px;
  padding:6px 16px;
  font-size:11.5px;font-weight:600;color:var(--teal);
  letter-spacing:1.6px;text-transform:uppercase;
  margin-bottom:22px;
}
.pulse-dot{
  width:6px;height:6px;border-radius:50%;background:var(--teal);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.4;transform:scale(0.8)}}

.hero h1{
  font-family:'Fraunces',serif;
  font-size:clamp(30px,5.5vw,50px);
  font-weight:700;
  line-height:1.1;
  color:var(--white);
  letter-spacing:-0.5px;
  margin-bottom:18px;
}
.hero h1 em{
  font-style:italic;
  color:var(--teal);
}

.hero-sub{
  font-size:16px;color:rgba(255,255,255,0.6);
  line-height:1.7;max-width:520px;margin:0 auto 28px;
}

.hero-tracks{
  display:flex;flex-wrap:wrap;justify-content:center;gap:10px;
  margin-bottom:10px;
}
.track-pill{
  background:var(--navy-mid);
  border:1px solid var(--border);
  color:rgba(255,255,255,0.75);
  border-radius:20px;padding:6px 16px;
  font-size:12px;font-weight:600;letter-spacing:0.3px;
}
.track-pill.teal{color:var(--teal);border-color:rgba(77,217,192,0.4)}

/* ── Progress bar (sticky) ──────────────────────────────── */
.progress-wrap{
  position:sticky;top:0;z-index:100;
  background:var(--white);
  border-bottom:1px solid var(--border-grey);
  padding:10px 24px;
  display:flex;align-items:center;gap:14px;
}
.progress-label{
  font-size:11.5px;font-weight:700;color:var(--teal-deep);
  text-transform:uppercase;letter-spacing:1px;white-space:nowrap;
  font-family:'DM Sans',sans-serif;
}
.progress-track{
  flex:1;height:5px;background:var(--grey-light);border-radius:10px;overflow:hidden;
}
.progress-fill{
  height:100%;
  background:linear-gradient(90deg,var(--teal-deep),var(--teal));
  border-radius:10px;
  width:0%;
  transition:width .4s ease;
}
.progress-pct{
  font-size:11.5px;font-weight:700;color:var(--grey);
  font-family:'DM Sans',sans-serif;white-space:nowrap;
}

/* ── Form card ──────────────────────────────────────────── */
.form-section{
  background:var(--white);
  padding-bottom:80px;
}

.form-card{
  max-width:680px;margin:0 auto;
  padding:0 24px;
}

/* Intro banner */
.form-intro{
  background:linear-gradient(135deg,var(--navy) 0%,var(--navy-mid) 100%);
  border-radius:16px;
  padding:32px 36px;
  margin-bottom:36px;
  position:relative;
  overflow:hidden;
}
.form-intro::before{
  content:'';position:absolute;top:-30px;right:-30px;
  width:140px;height:140px;border-radius:50%;
  background:radial-gradient(circle,rgba(77,217,192,0.12),transparent 70%);
}
.form-intro-label{
  font-size:10px;font-weight:800;letter-spacing:2px;
  text-transform:uppercase;color:var(--teal);
  margin-bottom:12px;display:block;
}
.form-intro p{
  font-size:14px;color:rgba(255,255,255,0.72);
  line-height:1.7;margin-bottom:10px;
}
.form-intro p:last-child{margin-bottom:0}
.form-intro a{color:var(--teal);text-decoration:underline}

/* Section groups */
.form-group-label{
  font-size:10px;font-weight:800;letter-spacing:2px;
  text-transform:uppercase;color:var(--teal-deep);
  margin-bottom:20px;padding-bottom:8px;
  border-bottom:2px solid var(--grey-light);
  display:flex;align-items:center;gap:10px;
}
.form-group-label span{
  background:var(--teal-deep);color:var(--white);
  width:22px;height:22px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;
  font-size:11px;flex-shrink:0;
}

.field-wrap{margin-bottom:22px}
.field-label{
  display:block;
  font-family:'DM Sans',sans-serif;
  font-size:13px;font-weight:700;
  color:var(--navy);
  text-transform:uppercase;letter-spacing:0.6px;
  margin-bottom:8px;
}
.field-label .req{color:var(--teal);margin-left:3px;font-size:14px}
.field-note{
  font-size:12px;color:var(--ink-soft);
  margin-top:5px;line-height:1.5;
  font-weight:400;text-transform:none;letter-spacing:0;
}

/* Text inputs */
input[type="text"],
input[type="email"],
textarea{
  width:100%;
  padding:13px 16px;
  border:1.5px solid var(--border-grey);
  border-radius:10px;
  font-family:'DM Sans',sans-serif;
  font-size:15px;
  color:var(--navy);
  background:var(--off-white);
  transition:border-color .2s,box-shadow .2s,background .2s;
  outline:none;
  -webkit-appearance:none;
}
input[type="text"]:focus,
input[type="email"]:focus,
textarea:focus,
select:focus{
  border-color:var(--teal);
  background:var(--white);
  box-shadow:0 0 0 3px rgba(77,217,192,0.14);
}
input::placeholder,textarea::placeholder{
  color:var(--grey);font-size:14px;
}
textarea{resize:vertical;min-height:100px;line-height:1.6}

/* Choice / radio / checkbox cards */
.choice-group{display:flex;flex-direction:column;gap:9px}
.choice-item{position:relative}
.choice-item input[type="radio"],
.choice-item input[type="checkbox"]{
  position:absolute;opacity:0;width:0;height:0;
}
.choice-item label{
  display:flex;align-items:flex-start;gap:12px;
  padding:13px 16px;
  border:1.5px solid var(--border-grey);
  border-radius:10px;
  cursor:pointer;
  font-size:14px;color:var(--ink-soft);
  transition:border-color .15s,background .15s;
  line-height:1.45;
  background:var(--off-white);
}
.choice-item label:hover{
  border-color:var(--teal);
  background:rgba(77,217,192,0.05);
}
.choice-item input:checked + label{
  border-color:var(--teal);
  background:rgba(77,217,192,0.08);
  color:var(--navy);
  font-weight:600;
}
.choice-indicator{
  width:18px;height:18px;
  border:2px solid var(--border-grey);
  border-radius:50%;
  flex-shrink:0;margin-top:1px;
  transition:all .15s;
  display:flex;align-items:center;justify-content:center;
  background:var(--white);
}
.choice-item input:checked + label .choice-indicator{
  border-color:var(--teal);background:var(--teal);
}
.choice-item input:checked + label .choice-indicator::after{
  content:'';width:7px;height:7px;border-radius:50%;background:var(--white);display:block;
}

/* Error states */
.field-error{
  font-size:12px;color:var(--error);
  margin-top:6px;display:none;font-weight:500;
}
.field-error.show{display:block}
input.invalid,textarea.invalid{border-color:var(--error)!important;box-shadow:0 0 0 3px rgba(229,62,62,0.1)!important}

/* Section divider */
.section-gap{margin-top:40px;margin-bottom:28px}

/* Submit button */
.submit-wrap{margin-top:36px}
.btn-submit{
  width:100%;
  padding:18px 28px;
  background:linear-gradient(135deg,var(--teal-deep),#1A9E8A);
  color:var(--white);
  font-family:'DM Sans',sans-serif;
  font-size:16px;font-weight:700;
  border:none;border-radius:12px;
  cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:10px;
  box-shadow:0 10px 28px -6px rgba(14,109,94,0.45);
  transition:transform .2s ease,box-shadow .2s ease,opacity .2s;
  letter-spacing:0.2px;
}
.btn-submit:hover{
  transform:translateY(-2px);
  box-shadow:0 16px 36px -6px rgba(14,109,94,0.55);
}
.btn-submit:disabled{opacity:.6;cursor:not-allowed;transform:none}
.btn-submit svg{width:18px;height:18px;transition:transform .2s}
.btn-submit:hover:not(:disabled) svg{transform:translateX(4px)}

/* Spinner */
.spinner{
  width:18px;height:18px;
  border:2.5px solid rgba(255,255,255,0.3);
  border-top-color:var(--white);
  border-radius:50%;
  animation:spin .7s linear infinite;
  display:none;
}
@keyframes spin{to{transform:rotate(360deg)}}

/* Privacy note */
.privacy-note{
  text-align:center;margin-top:14px;
  font-size:12px;color:var(--grey);line-height:1.5;
}
.privacy-note a{color:var(--teal-deep);text-decoration:underline}

/* ── Success screen ─────────────────────────────────────── */
.success-screen{
  display:none;
  padding:60px 24px 80px;
  text-align:center;
  max-width:600px;
  margin:0 auto;
}

/* Floating orbs behind the card */
.success-orb{
  position:absolute;border-radius:50%;pointer-events:none;
  filter:blur(60px);
}
.success-orb-1{
  width:320px;height:320px;
  background:rgba(77,217,192,0.14);
  top:-60px;left:50%;transform:translateX(-60%);
  animation:orbFloat1 8s ease-in-out infinite;
}
.success-orb-2{
  width:200px;height:200px;
  background:rgba(14,109,94,0.18);
  bottom:60px;right:10%;
  animation:orbFloat2 11s ease-in-out infinite;
}
@keyframes orbFloat1{0%,100%{transform:translateX(-60%) translateY(0)}50%{transform:translateX(-60%) translateY(-20px)}}
@keyframes orbFloat2{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}

/* Main glass card */
.success-glass{
  position:relative;
  background:rgba(255,255,255,0.04);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border:1px solid rgba(77,217,192,0.18);
  border-radius:28px;
  padding:52px 44px 44px;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.04) inset,
    0 40px 80px -20px rgba(0,0,0,0.4),
    0 0 60px -10px rgba(77,217,192,0.08);
  overflow:hidden;
}
.success-glass::before{
  content:'';position:absolute;
  top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(77,217,192,0.4),transparent);
}

/* Tick badge */
.success-icon{
  width:88px;height:88px;
  background:radial-gradient(circle at 40% 40%,rgba(77,217,192,0.25),rgba(77,217,192,0.06));
  border:1.5px solid rgba(77,217,192,0.35);
  border-radius:50%;
  margin:0 auto 30px;
  display:flex;align-items:center;justify-content:center;
  animation:popIn .55s cubic-bezier(.2,.9,.3,1.3) both;
  box-shadow:0 0 40px rgba(77,217,192,0.2), inset 0 0 20px rgba(77,217,192,0.06);
}
@keyframes popIn{from{transform:scale(0.4);opacity:0}to{transform:scale(1);opacity:1}}
.success-icon svg{width:38px;height:38px;stroke:var(--teal)}

.success-screen h2{
  font-family:'Fraunces',serif;font-size:clamp(26px,4vw,36px);font-weight:700;
  color:var(--white);margin-bottom:14px;line-height:1.15;letter-spacing:-0.3px;
}
.success-screen h2 em{color:var(--teal);font-style:italic}

.success-screen .lead{
  font-size:15px;color:rgba(255,255,255,0.6);
  line-height:1.7;margin-bottom:32px;max-width:420px;margin-left:auto;margin-right:auto;
}

/* Three next-step cards in a row */
.success-steps{
  display:grid;grid-template-columns:repeat(3,1fr);gap:12px;
  margin-bottom:32px;
  text-align:left;
}
@media(max-width:520px){.success-steps{grid-template-columns:1fr}}
.success-step{
  background:rgba(255,255,255,0.05);
  border:1px solid rgba(77,217,192,0.12);
  border-radius:14px;
  padding:18px 16px;
}
.step-num{
  width:28px;height:28px;border-radius:50%;
  background:rgba(77,217,192,0.15);
  border:1px solid rgba(77,217,192,0.3);
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:800;color:var(--teal);
  margin-bottom:10px;font-family:'DM Sans',sans-serif;
}
.success-step h4{
  font-family:'DM Sans',sans-serif;font-size:12.5px;font-weight:700;
  color:var(--white);margin-bottom:5px;
}
.success-step p{
  font-size:11.5px;color:rgba(255,255,255,0.5);line-height:1.5;margin:0;
}

/* Sponsor note */
.sponsor-note{
  background:rgba(245,166,35,0.08);
  border:1px solid rgba(245,166,35,0.2);
  border-radius:10px;padding:14px 18px;
  font-size:12.5px;color:rgba(255,255,255,0.6);
  line-height:1.55;margin-bottom:28px;text-align:left;
}
.sponsor-note strong{color:var(--amber);font-weight:700}

.success-contact{
  font-size:12px;color:rgba(255,255,255,0.35);line-height:1.7;
}
.success-contact a{color:rgba(77,217,192,0.65);text-decoration:none}
.success-contact a:hover{color:var(--teal)}

/* ── Footer ─────────────────────────────────────────────── */
.page-footer{
  background:var(--navy);
  padding:32px 24px;
  text-align:center;
  border-top:1px solid rgba(77,217,192,0.08);
}
.page-footer p{
  font-size:12px;color:rgba(255,255,255,0.3);
  line-height:1.6;
}
.page-footer a{color:rgba(77,217,192,0.7);text-decoration:none}

/* ── Responsive ─────────────────────────────────────────── */
@media(max-width:520px){
  .page-hero{padding:48px 20px 100px}
  .form-intro{padding:24px 22px}
  .form-card{padding:0 16px}
  .progress-wrap{padding:10px 16px}
}
</style>
</head>
<body>

<!-- HERO -->
<header class="page-hero">
  <div class="flame-glow"></div>
  <div class="hero-grain"></div>
  <div class="hero-inner">

    <div class="logo-wrap">
      <img class="logo-img"
           src="Preneurdemy_Logo_Seed_180x180-removebg-preview.png"
           alt="Preneurdemy logo"
           onerror="this.style.display='none'">
      <span class="logo-name">Preneurde<span>my</span></span>
    </div>

    <div class="hero-eyebrow">
      <span class="pulse-dot"></span>
      Now accepting interest — Cohort 1
    </div>

    <h1 style="color:#FFFFFF">Africa's AI-powered<br>talent programme</h1>

    <p class="hero-sub">
      We are preparing to launch our first cohort in three high-demand tracks.
      Register your interest today — places are limited and confirmed on a priority basis.
    </p>

    <div class="hero-tracks">
      <div class="track-pill teal">AI Digital Marketing</div>
      <div class="track-pill">AI Data Analytics</div>
      <div class="track-pill">AI &amp; Automation</div>
    </div>

  </div>
</header>

<!-- PROGRESS BAR (sticky, shown on scroll) -->
<div class="progress-wrap" id="progressWrap">
  <span class="progress-label">Progress</span>
  <div class="progress-track">
    <div class="progress-fill" id="progressFill"></div>
  </div>
  <span class="progress-pct" id="progressPct">0%</span>
</div>

<!-- FORM SECTION -->
<section class="form-section" id="formSection">
  <div class="form-card">

    <!-- Intro -->
    <div class="form-intro">
      <span class="form-intro-label">About this form</span>
      <p>Welcome to Preneurdemy — Africa's AI-powered digital talent development platform. By completing this form, you are registering your interest in joining our first cohort.</p>
      <p>Completing this form does not guarantee a place. It confirms your interest and ensures you are first to receive your confirmed start date and enrolment instructions. Takes approximately 3 minutes.</p>
      <p>All information is handled in accordance with our <a href="https://tech.preneurdemy.com/privacy-policy" target="_blank">Privacy Policy</a>.</p>
    </div>

    <form id="cohortForm" novalidate>

      <!-- SECTION A: Personal Details -->
      <div class="form-group-label section-gap" style="margin-top:0">
        <span>A</span>Personal Details
      </div>

      <!-- Q1 Full name -->
      <div class="field-wrap">
        <label class="field-label" for="full_name">
          Full Name <span class="req">*</span>
        </label>
        <input type="text" id="full_name" name="full_name"
               placeholder="e.g. Amara Okafor" required autocomplete="name">
        <div class="field-error" id="err-full_name">Please enter your full name.</div>
      </div>

      <!-- Q2 Email -->
      <div class="field-wrap">
        <label class="field-label" for="email">
          Email Address <span class="req">*</span>
        </label>
        <input type="email" id="email" name="email"
               placeholder="yourname@email.com" required autocomplete="email">
        <div class="field-error" id="err-email">Please enter a valid email address.</div>
      </div>

      <!-- Q3 WhatsApp -->
      <div class="field-wrap">
        <label class="field-label" for="whatsapp">
          WhatsApp Number <span class="req">*</span>
          <div class="field-note">Include your country code, e.g. +234 for Nigeria</div>
        </label>
        <input type="text" id="whatsapp" name="whatsapp"
               placeholder="+234 800 000 0000" required>
        <div class="field-error" id="err-whatsapp">Please enter your WhatsApp number with country code.</div>
      </div>

      <!-- SECTION B: Programme -->
      <div class="form-group-label section-gap">
        <span>B</span>Programme Preferences
      </div>

      <!-- Q4 Track -->
      <div class="field-wrap">
        <label class="field-label">
          Which programme track are you most interested in? <span class="req">*</span>
        </label>
        <div class="choice-group" id="track-group">
          <div class="choice-item">
            <input type="radio" name="track" id="track-marketing" value="AI Digital Marketing">
            <label for="track-marketing">
              <span class="choice-indicator"></span>
              AI Digital Marketing
            </label>
          </div>
          <div class="choice-item">
            <input type="radio" name="track" id="track-analytics" value="AI Data Analytics">
            <label for="track-analytics">
              <span class="choice-indicator"></span>
              AI Data Analytics
            </label>
          </div>
          <div class="choice-item">
            <input type="radio" name="track" id="track-automation" value="AI & Automation">
            <label for="track-automation">
              <span class="choice-indicator"></span>
              AI &amp; Automation
            </label>
          </div>
          <div class="choice-item">
            <input type="radio" name="track" id="track-unsure" value="Not sure yet">
